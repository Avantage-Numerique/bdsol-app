{
    "name": "avnu",
    "version": "1.0.3",
    "description": "Application frontend for interacting with AVNU api",
    "authors": [
        "Frédéric Rivard",
        "Marc-André Martin",
        "Vincent P. Ruel",
        "Jules Luzy-Riopel"
    ],
    "private": true,
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "dev:watch": "next dev",
        "build": "next build",
        "build:debug": "next build --debug",
        "build:staging": "next build && next export",
        "test": "jest --watch",
        "start": "next start -p 3000",
        "stop": "next stop",
        "docker:dev": "npx concurrently \"npm run build\" \"npm run dev\"",
        "docker:dev:watch": "npx concurrently \"npm run dev:watch\" \"npm run docker:dev:run\"",
        "docker:dev:run": "npx nodemon --legacy-watch",
        "docker:start": "next start -p 3000",
        "docker:test": "echo \"Error: no test specified\" && exit 1",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint:check": "eslint .",
        "lint:fix": "eslint --fix .",
        "check": "prettier --check . && eslint .",
        "fix": "prettier --write . && eslint --fix ."
    },
    "dependencies": {
        "@dnd-kit/core": "^6.0.8",
        "@dnd-kit/sortable": "^7.0.2",
        "@fullhuman/postcss-purgecss": "^5.0.0",
        "@popperjs/core": "^2.11.6",
        "@shopify/draggable": "^1.0.0-beta.8",
        "@socialgouv/matomo-next": "^1.2.1",
        "blotter": "^1.0.0",
        "bootstrap": "^5.3.8",
        "chroma-js": "^2.4.2",
        "date-fns": "^2.30.0",
        "date-fns-tz": "^2.0.0",
        "html-to-text": "^9.0.5",
        "iron-session": "^8.0.4",
        "isomorphic-dompurify": "^3.11.0",
        "jest-environment-jsdom": "^30.3.0",
        "line-awesome": "^1.3.0",
        "moment": "^2.29.4",
        "next": "16.2.6",
        "postcss-flexbugs-fixes": "^5.0.2",
        "postcss-preset-env": "^7.8.2",
        "quill": "^2.0.2",
        "react": "^18.2.0",
        "react-bootstrap": "^2.10.10",
        "react-dom": "^18.2.0",
        "react-popper": "^2.3.0",
        "react-quill": "^2.0.0",
        "react-scroll": "^1.8.7",
        "react-select": "^5.7.0",
        "sharp": "^0.34.4"
    },
    "devDependencies": {
        "@babel/core": "^7.21.4",
        "@babel/eslint-parser": "^7.28.6",
        "@testing-library/dom": "^9.3.1",
        "@testing-library/jest-dom": "^5.16.4",
        "@testing-library/react": "^13.2.0",
        "@testing-library/user-event": "^14.4.3",
        "concurrently": "^7.0.0",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "jest": "^28.1.0",
        "prettier": "^3.6.2",
        "purgecss": "^5.0.0",
        "sass": "^1.63.2"
    }
}
