{
    "name": "avnu",
    "version": "1.0.3",
    "description": "Application frontend for interacting with AVNU api",
    "authors": [
        "Frédéric Rivard",
        "Marc-André Martin",
        "Vincent P. Ruel",
        "Jules Luzy-Riopel"
    ],
    "private": true,
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "dev:watch": "next dev",
        "build": "next build",
        "build:debug": "next build --debug",
        "build:staging": "next build && next export",
        "test": "jest --watch",
        "start": "next start -p 3000",
        "stop": "next stop",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint:check": "eslint .",
        "lint:fix": "eslint --fix .",
        "check": "prettier --check . && eslint .",
        "fix": "prettier --write . && eslint --fix ."
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^7.0.2",
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@popperjs/core": "^2.11.8",
        "@socialgouv/matomo-next": "1.11.0",
        "blotter": "^1.0.0",
        "bootstrap": "^5.3.8",
        "chroma-js": "^3.2.0",
        "date-fns": "^2.30.0",
        "date-fns-tz": "^2.0.0",
        "html-to-text": "^10.0.1",
        "iron-session": "^8.0.4",
        "isomorphic-dompurify": "^4.6.0",
        "line-awesome": "^2.0.1",
        "moment": "^2.31.0",
        "next": "^16.4.2",
        "postcss-flexbugs-fixes": "^5.0.2",
        "postcss-preset-env": "^11.6.1",
        "quill": "^2.0.3",
        "react": "^18.2.0",
        "react-bootstrap": "^2.10.10",
        "react-dom": "^18.2.0",
        "react-popper": "^2.3.0",
        "react-quill": "^2.0.0",
        "react-scroll": "^1.9.3",
        "react-select": "^5.10.2",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@babel/core": "^8.0.7",
        "@babel/eslint-parser": "^8.0.7",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "prettier": "^3.9.10",
        "purgecss": "^8.0.0",
        "sass": "^1.106.1"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    }
